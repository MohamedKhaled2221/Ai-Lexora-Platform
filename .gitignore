__pycache__/
*.py[cod]
*$py.class

.pytest_cache/

.qdrant_storage/

.venv/
env/
venv/

.env

# Local/runtime files
*.log
# Local evaluation outputs
evaluation/results/
# ---------------------------------------------------------------------------
# M1 document processing
# Paths are anchored to m1/ deliberately: the module's own .gitignore rules
# were root-anchored in its standalone repo and would not match here otherwise.
# ---------------------------------------------------------------------------

# Confidentiality: firm documents must never be committed.
# Only the explanatory README in m1/test_corpus/real/ is tracked.
m1/test_corpus/real/*
!m1/test_corpus/real/README.md

# Generated at runtime -- reproducible, never reviewed
m1/output/
m1/logs/
m1/reports/evaluation_results.json

# Superseded and voided artifacts, kept on disk as local history
m1/reports/_INVALID_*
m1/reports/_superseded_*

# Large binaries fetched or generated by the setup steps in m1/README.md
m1/tessdata/*.traineddata
m1/test_corpus/public/*.pdf
m1/test_corpus/synthetic/*.pdf
m1/test_corpus/synthetic/*.docx
m1/test_corpus/synthetic/*.png

# ---------------------------------------------------------------------------
# Repo-wide rules carried over from the m1 standalone repo
# ---------------------------------------------------------------------------

# Secrets / local configuration
.env.*
!.env.example
*.pem
*.key
credentials.json

# Model weights and inference caches -- pulled on first run, never committed
models/
.cache/
.paddleocr/
.paddlex/
*.onnx
*.pt
*.pth
*.safetensors

# Superseded / backup files
*.bak
*.orig

# Test / lint / type caches
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# OS / editor / tooling
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
.qodo/
.claude/

# Scratch
tmp/
temp/
*.tmp

# Frontend dependencies and generated build output
node_modules/
dist/
