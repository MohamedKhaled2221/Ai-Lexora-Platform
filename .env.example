EMBEDDING_MODEL=BAAI/bge-m3
USE_FP16=true
BATCH_SIZE=8
MAX_LENGTH=512
NORMALIZE_EMBEDDINGS=true
# ==========================================
# M4 - Local LLM & AI Orchestration Settings
# ==========================================

# Ollama server
M4_OLLAMA_BASE_URL=http://localhost:11434

# Local model
M4_MODEL_NAME=qwen3.5:4b

# Generation settings
M4_TEMPERATURE=0.1
M4_NUM_CTX=4096
M4_NUM_PREDICT=512
M4_SEED=42

# Model lifecycle
M4_KEEP_ALIVE=10m

# Qwen thinking mode
M4_REASONING=false

# Startup validation
M4_VALIDATE_MODEL_ON_INIT=true

# Reliability
M4_REQUEST_TIMEOUT_SECONDS=120
M4_MAX_RETRIES=2

# ==========================================
# M3 -> M4 RAG Runtime
# ==========================================

# Persistent/local Qdrant service
RAG_QDRANT_LOCATION=http://localhost:6333

RAG_QDRANT_COLLECTION_NAME=legal_documents
RAG_QDRANT_VECTOR_SIZE=1024

RAG_CANDIDATE_TOP_K=20
RAG_FINAL_TOP_K=5

# May also be changed to a local model path
# for a fully offline deployment.
RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Production default: fail rather than silently
# downgrade retrieval quality.
RAG_RERANKER_USE_MOCK_FALLBACK=false
