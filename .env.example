# BGE-M3 must be provisioned before production startup.
#
# For a fully offline deployment, point this to the
# complete local snapshot instead of a Hugging Face ID.
#
# Development example:
# /home/<user>/ai-lexora-models/bge-m3
#
# Production example:
# /opt/ai-lexora/models/bge-m3
EMBEDDING_MODEL=/opt/ai-lexora/models/bge-m3
USE_FP16=true
BATCH_SIZE=8
MAX_LENGTH=512
NORMALIZE_EMBEDDINGS=true
# ==========================================
# M4 - Local LLM & AI Orchestration Settings
# ==========================================

# Ollama server
M4_OLLAMA_BASE_URL=http://localhost:11434

# Local model
M4_MODEL_NAME=qwen3.5:4b

# Generation settings
M4_TEMPERATURE=0.1
M4_NUM_CTX=4096
M4_NUM_PREDICT=512
M4_SEED=42

# Model lifecycle
M4_KEEP_ALIVE=10m

# Qwen thinking mode
M4_REASONING=false

# Startup validation
M4_VALIDATE_MODEL_ON_INIT=true

# Reliability
M4_REQUEST_TIMEOUT_SECONDS=120
M4_MAX_RETRIES=2

# ==========================================
# M3 -> M4 RAG Runtime
# ==========================================

# Persistent/local Qdrant service
RAG_QDRANT_LOCATION=http://localhost:6333

RAG_QDRANT_COLLECTION_NAME=legal_documents
RAG_QDRANT_VECTOR_SIZE=1024

RAG_CANDIDATE_TOP_K=20
RAG_FINAL_TOP_K=5

# The production reranker must also be provisioned
# locally before startup.
RAG_RERANKER_MODEL_NAME=/opt/ai-lexora/models/bge-reranker-v2-m3

# Production default: fail rather than silently
# downgrade retrieval quality.
RAG_RERANKER_USE_MOCK_FALLBACK=false
# ==========================================
# Strict Offline Runtime
# ==========================================

# Prevent Hugging Face Hub network access.
HF_HUB_OFFLINE=1

# Additional offline flags used by HF ecosystem
# components that may be introduced upstream.
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# AI-Lexora production offline policy.
RAG_STRICT_OFFLINE=true

# Never download the BGE reranker during runtime.
RAG_RERANKER_LOCAL_FILES_ONLY=true

# Production should fail instead of silently
# switching to heuristic reranking.
RAG_RERANKER_USE_MOCK_FALLBACK=false


# ==========================================
# FastAPI Transport Security
# ==========================================

# development | production
API_ENVIRONMENT=development

# Must always be false in production.
API_DEBUG=false

# Development may expose Swagger/OpenAPI.
# Production startup rejects true.
API_DOCS_ENABLED=true

# Maximum HTTP request body.
# Default: 1 MiB.
API_MAX_REQUEST_BODY_BYTES=1048576

# Development may disable this for local tooling.
# Production requires host enforcement.
API_TRUSTED_HOST_ENFORCEMENT=false

# Exact local hostnames/IP addresses only.
# Wildcards are intentionally rejected.
API_TRUSTED_HOSTS=["127.0.0.1","localhost","::1"]

# Empty means browser cross-origin access is denied.
# Add only the exact frontend origin when known.
# Example:
# ["http://127.0.0.1:5500"]
API_CORS_ALLOWED_ORIGINS=[]

# Keep this minimal.
# Add Authorization later only if the team
# authentication architecture requires it.
API_CORS_ALLOWED_HEADERS=["Content-Type"]

API_CORS_ALLOW_CREDENTIALS=false

# ==========================================
# Safe Operational Logging
# ==========================================

# Development:
# standard
#
# Production:
# json
API_LOG_OUTPUT_FORMAT=standard

# DEBUG | INFO | WARNING | ERROR | CRITICAL
API_LOG_LEVEL=INFO

# AI-Lexora emits its own sanitized HTTP event.
# Disable Uvicorn's duplicate access log.
API_LOG_DISABLE_UVICORN_ACCESS_LOG=true

# ==========================================
# Production Process Deployment
# ==========================================

# AI-Lexora currently targets local-machine
# deployment only.
DEPLOY_HOST=127.0.0.1

DEPLOY_PORT=8000

# Must remain 1 on the current deployment
# architecture. Additional workers duplicate
# the loaded ML runtimes.
DEPLOY_WORKERS=1