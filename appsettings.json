{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LegalAssistant;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "LegalAssistant",
    "Audience": "LegalAssistantClients"
  },
  "AdminSeed": {
    "Email": "",
    "Password": "",
    "FullName": "Default Admin"
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [ ".pdf", ".docx", ".txt", ".png", ".jpg", ".jpeg" ]
  },
  "Cors": {
    // Real, deployed frontend origin(s) only - no trailing slash, e.g. "https://app.lexora.com".
    // Leave empty ONLY for local development; Program.cs falls back to AllowAnyOrigin
    // when this list is empty AND ASPNETCORE_ENVIRONMENT=Development, and refuses to
    // start with AllowAnyOrigin in any other environment.
    "AllowedOrigins": []
  },
  "Email": {
    "From": "no-reply@legalassistant.local",
    "FrontendBaseUrl": "http://localhost:3000",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true
    }
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 60,
    "QuestionTimeoutSeconds": 180,
    "IngestionTimeoutSeconds": 360,
    "ClientId": "client_test",
    "ConfidentialityCeiling": "privileged"
  },
  "M1Service": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutSeconds": 120
  },
  "M5Service": {
    "BaseUrl": "http://localhost:8002",
    "TimeoutSeconds": 60
  },
  "HealthCheck": {
    // Path appended to each service's BaseUrl when /health probes them.
    // Update these if the Python services expose a different health route.
    "AiService": {
      "Path": "/health",
      "TimeoutSeconds": 5
    },
    "M1Service": {
      "Path": "/health",
      "TimeoutSeconds": 5
    },
    "M5Service": {
      "Path": "/health",
      "TimeoutSeconds": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}